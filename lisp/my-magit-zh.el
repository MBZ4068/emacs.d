  "Magit 英文串 -> 中文串 对照表。
键是 Magit 原始英文（区分大小写、须完全相等），值是替换后的中文。"
  :type '(alist :key-type string :value-type string))

(defcustom my-magit-zh-patterns
  '(("\\`Push \\(.+\\) to\\'"       . "把 \\1 推送到")
    ("\\`Pull into \\(.+\\) from\\'"  . "从远程拉到 \\1")
    ("\\`Configure \\(.+\\)\\'"        . "配置 \\1")
    ("\\`Merge \\(.+\\) into\\'"       . "合并 \\1 到")
    ("\\`Rebase \\(.+\\) onto\\'"      . "把 \\1 变基到"))
  "动态生成的描述的替代表：REGEXP 与替换串（替换串里可用 \\\\1 引用分组）。
Magit 有些菜单标题带分支名，如 \"Push main to\"，只能靠正则匹配。"
  :type '(alist :key-type string :value-type string))

(defcustom my-magit-zh-headers
  '(("Head:"     . "HEAD:")
    ("Merge:"    . "合并:")
    ("Rebase:"   . "变基:")
    ("Push:"     . "推送:")
    ("Tag:"      . "标签:")
    ("Tags:"     . "多个标签:")
    ("Remote:"   . "远程:")
    ("Upstream:" . "上游:")
    ("User:"     . "用户:")
    ("GitError!" . "Git 错误!")
    ("Filter!"   . "过滤!")
    ("Sparse!"   . "稀疏!"))
  "状态缓冲区顶部那几行的标签（`Head: ' 这种）的对照表。"
  :type '(alist :key-type string :value-type string))

(defconst my-magit-zh--header-functions
  '(magit-insert-head-branch-header
    magit-insert-upstream-branch-header
    magit-insert-push-branch-header
    magit-insert-tags-header
    magit-insert-remote-header
    magit-insert-user-header
    magit-insert-error-header
    magit-insert-diff-filter-header
    magit-sparse-checkout-insert-header)
  "会产生 `Head: ' 之类头部行的函数。")

(defvar my-magit-zh--index nil
  "对照表的归一化索引：折叠空白后的英文 -> 中文。")

(defun my-magit-zh--norm (str)
  "把 STR 里的连续空白（含换行）折成一个空格并去掉首尾空白。"
  (string-trim (replace-regexp-in-string "[ \t\n]+" " " str)))

(defun my-magit-zh--build-index ()
  "重建归一化索引。"
  (setq my-magit-zh--index (make-hash-table :test #'equal))
  (dolist (pair my-magit-zh-alist)
    (puthash (my-magit-zh--norm (car pair)) (cdr pair) my-magit-zh--index)))

(defun my-magit-zh--translate (str)
  "若 STR 在对照表里，返回中文串（尽量保留原来的 face），否则返回 STR。
若 STR 命中不了，会再拿去掉首尾空格后的版本试一次，命中时保留原有的
首尾空白 —— Magit 有些菜单项是靠前置空格来对齐的。"
  (if (not (stringp str))
      str
    (let* ((plain (substring-no-properties str))
           (hit (assoc plain my-magit-zh-alist))
           (zh (cond
                (hit (cdr hit))
                ((let* ((trimmed (string-trim plain))
                        (hit2 (and (not (equal trimmed plain))
                                   (assoc trimmed my-magit-zh-alist))))
                   (when hit2
                     (let* ((lead-len (- (length plain)
                                         (length (string-trim-left plain))))
                            (trail-len (- (length plain)
                                          (length (string-trim-right plain))))
                            (lead (substring plain 0 lead-len))
                            (trail (if (> trail-len 0)
                                       (substring plain (- (length plain) trail-len))
                                     "")))
                       (concat lead (cdr hit2) trail)))))
                ((and my-magit-zh--index
                      (gethash (my-magit-zh--norm plain) my-magit-zh--index)))
                ((let ((pat (seq-find (lambda (p) (string-match-p (car p) plain))
                                      my-magit-zh-patterns)))
                   (when pat
                     (replace-regexp-in-string (car pat) (cdr pat) plain)))))))
      (if (not zh)
          str
        (let ((face (get-text-property 0 'face str)))
          (if face
              (propertize zh 'face face)
            zh))))))

(defun my-magit-zh--pad (str width)
  "把 STR 右侧补空格到显示宽度 WIDTH（中文按 2 列算）。"
  (concat str (make-string (max 1 (- width (string-width str))) ?\s)))

(defun my-magit-zh--fix-header-region (beg end)
  "把 BEG..END 里以 `Head: ' 这类标签开头的行换成中文标签。"
  (save-excursion
    (save-restriction
      (narrow-to-region beg end)
      (goto-char (point-min))
      (while (re-search-forward
              "^ *\\(Head\\|Merge\\|Rebase\\|Push\\|Tags\\|Tag\\|Remote\\|Upstream\\|User\\|GitError\\|Filter\\|Sparse\\)\\([:!]\\) *"
              nil t)
        (let* ((label (concat (match-string 1) (match-string 2)))
               (zh (cdr (assoc label my-magit-zh-headers))))
          (when zh
            (replace-match (my-magit-zh--pad zh 10) t t)))))))

(defun my-magit-zh--advice-header (fn &rest args)
  "调用 FN 后，把它刚插入的头部标签换成中文。"
  (let ((beg (copy-marker (point))))
    (unwind-protect
        (apply fn args)
      (ignore-errors (my-magit-zh--fix-header-region (marker-position beg) (point)))
      (set-marker beg nil))))

(defun my-magit-zh--filter-args (args)
  "把 `magit-insert-heading' 的字符串参数逐条翻译。"
  (mapcar #'my-magit-zh--translate args))

(defun my-magit-zh--fit (orig zh)
  "若 ORIG 原本靠空格对齐，就把 ZH 补到 ORIG 的显示宽度，免得分栏错位。"
  (if (or (not (stringp orig)) (not (stringp zh)) (equal orig zh))
      zh
    (let ((w (length orig))
          (zw (length zh)))
      (if (and (not (equal orig (string-trim orig))) (< zw w))
          (concat zh (make-string (- w zw) ?\s))
        zh))))

(defun my-magit-zh--advice-description (fn obj)
  "翻译 FN 对 OBJ 取到的描述串。"
  (let ((orig (funcall fn obj)))
    (my-magit-zh--fit orig (my-magit-zh--translate orig))))

(defun my-magit-zh--advice-format (fn obj)
  "翻译 FN 格式化后的整段描述。
有的条目（如 g / q / <tab>）没有显式 description，Transient 会退回到
命令 docstring 的第一行当说明，这条路径绕过了 `transient--get-description'，
所以在 `transient-format-description' 这一层再兜一次。"
  (let ((orig (funcall fn obj)))
    (my-magit-zh--fit orig (my-magit-zh--translate orig))))

(defun my-magit-zh-enable ()
  "开启 Magit 界面中文化。"
  (interactive)
  (my-magit-zh--build-index)
  (advice-add 'magit-insert-heading :filter-args #'my-magit-zh--filter-args)
  (advice-add 'transient--get-description :around
              #'my-magit-zh--advice-description)
  (advice-add 'transient-format-description :around
              #'my-magit-zh--advice-format)
  (dolist (fn my-magit-zh--header-functions)
    (advice-add fn :around #'my-magit-zh--advice-header))
  (message "Magit 中文化：已开启"))

(defun my-magit-zh-disable ()
  "关闭 Magit 界面中文化。"
  (interactive)
  (advice-remove 'magit-insert-heading #'my-magit-zh--filter-args)
  (advice-remove 'transient--get-description #'my-magit-zh--advice-description)
  (advice-remove 'transient-format-description #'my-magit-zh--advice-format)
  (dolist (fn my-magit-zh--header-functions)
    (advice-remove fn #'my-magit-zh--advice-header))
  (message "Magit 中文化：已关闭"))

(provide 'my-magit-zh)
